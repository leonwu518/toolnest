# 复制为 .env（本地）或在 Cloudflare Pages 环境变量中配置
# 用于 canonical / hreflang / sitemap.xml 的绝对地址
SITE_URL=https://www.toolwild.com

# GA4 衡量 ID（G- 开头）。留空 = 完全不加载任何统计脚本。
# 仅生产构建（npm run build）注入；开发环境（npm run dev）不注入。
# 在 GA4 后台：管理 → 数据流 → Web 数据流 → 衡量 ID
PUBLIC_GA4_MEASUREMENT_ID=

# Formspree 反馈表单端点（在 formspree.io 创建表单后获得，形如 https://formspree.io/f/xxxxxx）
# 未配置时反馈页会停用提交并提示改用邮件；Cloudflare Pages 需在环境变量中同样设置。
PUBLIC_FORMSPREE_ENDPOINT=
