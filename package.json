{
  "name": "toolnest",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ToolNest - A Smart Toolbox for Everyday Work. Free online tools, processed locally in your browser.",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "astro build",
    "preview": "astro preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "verify": "node scripts/verify-build.mjs",
    "check:project": "node scripts/check-project.mjs",
    "gen:icons": "node scripts/gen-icons.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "verify:analytics": "node scripts/verify-analytics.mjs"
  },
  "dependencies": {
    "astro": "^5.13.0",
    "jszip": "^3.10.1",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "lucide-static": "^1.80.0",
    "puppeteer-core": "^24.10.0"
  },
  "engines": {
    "node": ">=20.3.0"
  }
}