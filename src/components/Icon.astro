---
import icons from '../data/icons.json';
const {
  name = 'circle-dot',
  size = 20,
  class: className,
  fill = 'none',
  strokeWidth = 2,
} = Astro.props;
const inner = icons[name] || icons['circle-dot'] || '';
---
<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={fill}
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  data-icon={name}
><Fragment set:html={inner} /></svg>
