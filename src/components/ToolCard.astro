---
import Icon from './Icon.astro';
import { toolUrl } from '../lib/site.js';
const { lang, meta, t, catName, catIcon = 'layers', accent = 'blue', badge = '', badgeLabel = '' } = Astro.props;
---
<a class="tool-card" href={toolUrl(lang, meta.slug)}>
  <div class="tool-card-top">
    <span class:list={['tool-icon', `accent-${accent}`]}><Icon name={meta.icon} size={21} /></span>
    {badge && <span class:list={['badge', `badge-${badge}`]}>{badgeLabel}</span>}
  </div>
  <h3>{t.name}</h3>
  <p>{t.short || t.desc}</p>
  <div class="tool-card-foot">
    <span class="cat"><Icon name={catIcon} size={13} />{catName}</span>
    <span class="arrow"><Icon name="arrow-right" size={15} /></span>
  </div>
</a>
