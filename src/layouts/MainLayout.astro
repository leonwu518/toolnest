---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getDict, dictionaries } from '../i18n/index.js';
import { tools } from '../data/tools.js';
import { categoryById } from '../data/categories.js';
import icons from '../data/icons.json';
import { seoLinks, absoluteUrl, langPath, SITE, escapeHtml } from '../lib/site.js';

const {
  lang = 'zh',
  title,
  description,
  path,
  active = '',
  tool = null,
  toolI18n = null,
} = Astro.props;

const dict = getDict(lang);
const links = seoLinks(lang, path);
const canonical = links.canonical;
const zh = dictionaries.zh;
const en = dictionaries.en;

/* 客户端界面文案：以英文兜底，覆盖当前语言，再覆盖当前工具专属文案 */
/* 只注入标量文案，排除页面正文/数组等内容，避免 HTML 体积膨胀 */
const flatten = (d) => {
  const out = {};
  for (const group of ['common', 'actions', 'theme', 'langSwitch', 'search', 'toolPage', 'categoryPage', 'dataPage']) {
    for (const [key, value] of Object.entries(d[group] || {})) {
      if (typeof value === 'string' || typeof value === 'number') out[key] = value;
    }
  }
  return out;
};
const clientUI = {
  ...flatten(en),
  ...flatten(dict),
  ...(tool ? (en.tools[tool]?.ui || {}) : {}),
  ...(toolI18n?.ui || {}),
};

/* 全站工具搜索索引（中英文均可搜索），图标内联，避免任何运行时图标库 */
const searchIndex = tools.map((m) => {
  const z = zh.tools[m.slug];
  const e = en.tools[m.slug];
  const catZh = zh.categories[m.category]?.name || '';
  const catEn = en.categories[m.category]?.name || '';
  return {
    s: m.slug,
    c: m.category,
    i: m.icon,
    a: categoryById[m.category]?.accent || 'blue',
    v: icons[m.icon] || icons['circle-dot'] || '',
    zh: { n: z.name, d: z.short || z.desc, c: catZh, k: [z.name, z.short, z.desc, ...(z.keywords || []), catZh, m.slug].join(' ') },
    en: { n: e.name, d: e.short || e.desc, c: catEn, k: [e.name, e.short, e.desc, ...(e.keywords || []), catEn, m.slug].join(' ') },
  };
});
const indexJson = JSON.stringify(searchIndex).replace(/</g, '\\u003c');

const siteLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'ToolNest',
  url: SITE,
  description: dict.siteDescription,
  inLanguage: lang === 'zh' ? 'zh-CN' : 'en',
  publisher: { '@type': 'Organization', name: 'ToolNest', url: SITE },
}).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang={dict.htmlLang} data-lang={lang} data-theme="light" data-tool={tool || ''} data-ui={JSON.stringify(clientUI)}>
<head>
  <meta charset="utf-8" />
  <script is:inline>
    (function () {
      try {
        var t = localStorage.getItem('toolnest.theme');
        if (t !== 'dark' && t !== 'light') {
          t = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.setAttribute('data-theme', t);
      } catch (e) { document.documentElement.setAttribute('data-theme', 'light'); }
    })();
  </script>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {links.alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
  <meta name="robots" content="index, follow, max-image-preview:large" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="ToolNest" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:locale" content={dict.ogLocale} />
  <meta property="og:locale:alternate" content={lang === 'zh' ? 'en_US' : 'zh_CN'} />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="theme-color" content="#2563eb" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <script type="application/ld+json" set:html={siteLd}></script>
  <script type="application/json" id="tool-index" set:html={indexJson}></script>
</head>
<body>
  <Header lang={lang} dict={dict} path={path} active={active} />
  <main class="container">
    <slot />
  </main>
  <Footer lang={lang} dict={dict} />
  <div class="toast-host" id="toast-host"></div>
  <script>import '../scripts/site-client.js';</script>
</body>
</html>
