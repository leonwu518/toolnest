---
/* 中文：静态内容页（about/contact/privacy/terms/suggest/changelog/data） */
import StaticPage from '../templates/StaticPage.astro';

export function getStaticPaths() {
  return ['about', 'contact', 'privacy', 'terms', 'suggest', 'changelog', 'data']
    .map((page) => ({ params: { page }, props: { lang: 'zh' } }));
}

const { lang } = Astro.props;
---
<StaticPage lang={lang} page={Astro.params.page} />
