---
import { seoLinks, SITE, absoluteUrl } from '../lib/site.js';
const canonical = absoluteUrl('/');
---
<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>ToolWild · A Smart Toolbox for Everyday Work</title>
  <meta name="description" content="ToolWild — 免费在线工具平台：文本、图片、PDF、计算、开发与效率工具，全部在浏览器本地处理。Free online tools, processed locally in your browser." />
  <link rel="canonical" href={canonical} />
  <link rel="alternate" hreflang="zh" href={absoluteUrl('/zh/')} />
  <link rel="alternate" hreflang="en" href={absoluteUrl('/en/')} />
  <link rel="alternate" hreflang="x-default" href={absoluteUrl('/zh/')} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="robots" content="index, follow" />
  <style>
    :root { color-scheme: light dark; }
    body { margin: 0; min-height: 100vh; display: grid; place-items: center; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif; background: #f8fafc; color: #0f172a; padding: 24px; }
    @media (prefers-color-scheme: dark) { body { background: #0b1120; color: #e8eef8; } .card { background: #131c2e; border-color: #263449; } }
    .card { width: min(100%, 480px); padding: 34px; background: #fff; border: 1px solid #e2e8f0; border-radius: 16px; box-shadow: 0 12px 32px rgba(15,23,42,.08); text-align: center; }
    .logo { width: 46px; height: 46px; margin: 0 auto 16px; border-radius: 12px; background: #2563eb; display: grid; place-items: center; }
    h1 { font-size: 1.55rem; margin: 0 0 6px; letter-spacing: -.03em; }
    .tag { color: #64748b; font-size: .92rem; margin: 0 0 26px; }
    .langs { display: grid; gap: 12px; }
    .langs a { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 15px 18px; border: 1px solid #cbd5e1; border-radius: 12px; color: inherit; text-decoration: none; font-weight: 650; transition: border-color .15s, background .15s; }
    .langs a:hover { border-color: #2563eb; background: #eff6ff; }
    .langs a span:last-child { color: #2563eb; }
    .langs small { display: block; font-weight: 400; color: #94a3b8; font-size: .8rem; }
    .note { margin-top: 22px; font-size: .8rem; color: #94a3b8; line-height: 1.6; }
  </style>
  <script is:inline>
    (function () {
      try {
        var saved = localStorage.getItem('toolwild.lang');
        var preferred = saved || ((navigator.language || '').toLowerCase().startsWith('zh') ? 'zh' : 'en');
        if (location.search.indexOf('noauto') === -1) {
          location.replace('/' + (preferred === 'zh' ? 'zh' : 'en') + '/');
        }
      } catch (e) {}
    })();
  </script>
</head>
<body>
  <div class="card">
    <div class="logo">
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76Z"/></svg>
    </div>
    <h1>ToolWild</h1>
    <p class="tag">A Smart Toolbox for Everyday Work · 日常工作的智能工具箱</p>
    <div class="langs">
      <a href="/zh/" hreflang="zh-CN"><span>简体中文<small>中文界面 · 23 个免费在线工具</small></span><span aria-hidden="true">→</span></a>
      <a href="/en/" hreflang="en"><span>English<small>English interface · 23 free online tools</small></span><span aria-hidden="true">→</span></a>
    </div>
    <p class="note">Your language preference is saved locally in this browser. Add <code>?noauto</code> to this URL to disable automatic redirect.<br />语言偏好仅保存在本机浏览器，加 <code>?noauto</code> 可关闭自动跳转。</p>
  </div>
</body>
</html>
