---
import MainLayout from '../layouts/MainLayout.astro';
import ToolShell from '../components/ToolShell.astro';
import { getDict, getToolI18n } from '../i18n/index.js';
import { toolBySlug, relatedTools } from '../data/tools.js';
import { toolUrl } from '../lib/site.js';

/* 共享页面模板：语言与 slug 均由路由包装器通过 props 传入 */
const { lang, slug } = Astro.props;
const meta = toolBySlug[slug];
if (!meta) throw new Error(`未知工具 slug: ${slug}`);

const dict = getDict(lang);
const t = getToolI18n(lang, slug);
const catName = dict.categories[meta.category].name;
const path = toolUrl(lang, slug);
const related = relatedTools(slug, 6).map((m) => ({ ...m, name: getToolI18n(lang, m.slug).name }));

/* 按 slug 动态加载对应工具的 UI 组件；缺失时直接让构建失败，避免交付空页面 */
const uiModules = import.meta.glob('../tools/**/*.astro', { eager: true });
const uiKey = `../tools/${meta.category}/${slug}.astro`;
const ToolUI = uiModules[uiKey]?.default;
// 构建期强制校验：任何工具缺少 UI 组件或页面结构不完整都会导致构建失败
if (!ToolUI) throw new Error(`工具 UI 组件缺失: src/tools/${meta.category}/${slug}.astro`);
---
<MainLayout lang={lang} title={t.seoTitle} description={t.seoDesc} path={path} active={meta.category} tool={slug} toolI18n={t}>
  <ToolShell lang={lang} dict={dict} meta={meta} t={t} catName={catName} related={related} canonical={new URL(path, Astro.site || 'https://www.toolwild.com').href}>
    <ToolUI dict={dict} tool={t} lang={lang} />
  </ToolShell>
</MainLayout>
