---
import Icon from '../../components/Icon.astro';
const { tool } = Astro.props;
const ui = tool.ui;
---
<div class="tool-ui">
  <div class="field-grid three">
    <div class="field"><label for="cbm-l">{ui.lengthLabel}</label><input class="input" type="number" step="any" min="0" id="cbm-l" data-role="length" placeholder="60" /></div>
    <div class="field"><label for="cbm-w">{ui.widthLabel}</label><input class="input" type="number" step="any" min="0" id="cbm-w" data-role="width" placeholder="40" /></div>
    <div class="field"><label for="cbm-h">{ui.heightLabel}</label><input class="input" type="number" step="any" min="0" id="cbm-h" data-role="height" placeholder="30" /></div>
  </div>
  <div class="field" style="margin-top:14px"><label for="cbm-q">{ui.qtyLabel}</label><input class="input" type="number" step="1" min="1" id="cbm-q" data-role="qty" placeholder="100" /></div>
  <div class="tool-actions">
    <button type="button" class="btn btn-primary" data-role="run"><Icon name="calculator" size={16} /> {ui.runLabel}</button>
    <button type="button" class="btn btn-ghost" data-role="clear"><Icon name="eraser" size={16} /> {Astro.props.dict.actions.clear}</button>
  </div>
  <div class="alert alert-error" data-role="error" hidden></div>
  <h3 class="tool-section-title" style="margin-top:22px"><Icon name="calculator" /> {ui.perLabel}</h3>
  <div class="stat-grid">
    <div class="stat-card"><div class="stat-label">{ui.perLabel}</div><div class="stat-value" data-role="per">—</div></div>
    <div class="stat-card"><div class="stat-label">{ui.totalLabel}</div><div class="stat-value" data-role="total">—</div></div>
    <div class="stat-card" style="grid-column:span 2"><div class="stat-label"><Icon name="book-open" size={14} /> {ui.processLabel}</div><div class="stat-value" style="font-size:1.02rem;font-family:var(--mono)" data-role="formula">—</div></div>
  </div>
  <p class="field-hint" style="margin-top:10px">{ui.hint}</p>
</div>
