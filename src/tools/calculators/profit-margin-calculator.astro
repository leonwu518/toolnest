---
import Icon from '../../components/Icon.astro';
const { dict, tool } = Astro.props;
const ui = tool.ui, a = dict.actions;
---
<div class="tool-ui">
  <div class="field-grid four">
    <div class="field"><label for="pm-cost">{ui.costLabel}</label><input class="input" type="number" step="any" min="0" id="pm-cost" data-role="cost" value="80" /></div>
    <div class="field"><label for="pm-price">{ui.priceLabel}</label><input class="input" type="number" step="any" min="0" id="pm-price" data-role="price" value="100" /></div>
    <div class="field"><label for="pm-qty">{ui.quantityLabel}</label><input class="input" type="number" step="any" min="0" id="pm-qty" data-role="quantity" value="1" /></div>
    <div class="field"><label for="pm-extra">{ui.extraCostLabel}</label><input class="input" type="number" step="any" min="0" id="pm-extra" data-role="extra" value="0" /></div>
  </div>

  <h3 class="tool-section-title" style="margin-top:22px"><Icon name="trending-up" /> {ui.resultLabel}</h3>
  <div class="stat-grid">
    <div class="stat-card"><div class="stat-label"><Icon name="percent" size={14} /> {ui.marginLabel}</div><div class="stat-value"><span data-role="margin">—</span><span class="stat-unit">%</span></div></div>
    <div class="stat-card"><div class="stat-label"><Icon name="trending-up" size={14} /> {ui.markupLabel}</div><div class="stat-value"><span data-role="markup">—</span><span class="stat-unit">%</span></div></div>
    <div class="stat-card"><div class="stat-label"><Icon name="wallet" size={14} /> {ui.profitLabel}</div><div class="stat-value" data-role="profit">—</div></div>
    <div class="stat-card"><div class="stat-label"><Icon name="circle-dot" size={14} /> {ui.unitProfitLabel}</div><div class="stat-value" data-role="unit-profit">—</div></div>
    <div class="stat-card"><div class="stat-label"><Icon name="chart-no-axes-combined" size={14} /> {ui.revenueLabel}</div><div class="stat-value" data-role="revenue">—</div></div>
    <div class="stat-card"><div class="stat-label"><Icon name="database" size={14} /> {ui.totalCostLabel}</div><div class="stat-value" data-role="total-cost">—</div></div>
  </div>

  <div class="tool-actions">
    <button type="button" class="btn btn-primary" data-role="run"><Icon name="calculator" size={16} /> {ui.runLabel}</button>
    <button type="button" class="btn btn-ghost" data-role="clear"><Icon name="rotate-ccw" size={16} /> {a.reset}</button>
  </div>
  <div class="alert alert-error" data-role="error" hidden></div>
  <div class="status-line" data-role="status">{ui.note}</div>
</div>
