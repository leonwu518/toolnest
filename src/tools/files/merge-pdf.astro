---
import Icon from '../../components/Icon.astro';
const { dict, tool } = Astro.props;
const ui = tool.ui, a = dict.actions;
---
<div class="tool-ui">
  <label class="file-drop" data-role="file-drop">
    <Icon name="upload" size={28} />
    <strong>{ui.selectLabel}</strong>
    <small>{ui.hint}</small>
    <input type="file" data-role="file-input" accept="application/pdf,.pdf" multiple />
  </label>
  <div class="btn-row" style="margin-top:12px">
    <button type="button" class="btn btn-outline btn-sm" data-role="add-more"><Icon name="plus" size={15} /> {ui.addMore}</button>
  </div>

  <h3 class="tool-section-title" style="margin-top:20px"><Icon name="files" /> {ui.fileList}</h3>
  <div class="file-list" data-role="file-list"></div>
  <div class="status-line" data-role="total-pages"></div>
  <p class="field-hint">{ui.orderHint}</p>

  <div class="tool-actions">
    <button type="button" class="btn btn-primary" data-role="run"><Icon name="files" size={16} /> {ui.runLabel}</button>
    <button type="button" class="btn btn-ghost" data-role="clear"><Icon name="eraser" size={16} /> {a.clear}</button>
  </div>
  <div class="alert alert-error" data-role="error" hidden></div>
  <div class="status-line" data-role="status"></div>
  <p class="field-hint">{ui.emptyHint}</p>
</div>
