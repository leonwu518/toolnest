---
import Icon from '../../components/Icon.astro';
const { dict, tool } = Astro.props;
const ui = tool.ui, a = dict.actions;
---
<div class="tool-ui">
  <label class="file-drop" data-role="file-drop">
    <Icon name="upload" size={28} />
    <strong>{ui.selectLabel}</strong>
    <small>{ui.hint}</small>
    <input type="file" data-role="file-input" accept="image/jpeg,image/png,image/webp" />
  </label>
  <div class="status-line" data-role="file-info"></div>

  <div class="field-grid two" style="margin-top:16px">
    <div class="field">
      <label for="cv-format">{ui.targetFormat}</label>
      <select class="select" id="cv-format" data-role="format">
        <option value="png">PNG</option>
        <option value="jpg">JPG</option>
        <option value="webp">WEBP</option>
      </select>
    </div>
    <div class="field">
      <label for="cv-quality">{ui.quality}</label>
      <div class="range-row">
        <input type="range" id="cv-quality" data-role="quality" min="10" max="100" value="92" />
        <span class="range-value" data-role="quality-value">92%</span>
      </div>
    </div>
  </div>

  <div class="tool-actions">
    <button type="button" class="btn btn-primary" data-role="run"><Icon name="refresh-cw" size={16} /> {ui.runLabel}</button>
    <button type="button" class="btn btn-outline" data-role="download" disabled><Icon name="download" size={16} /> {ui.downloadLabel}</button>
    <button type="button" class="btn btn-ghost" data-role="clear"><Icon name="eraser" size={16} /> {a.clear}</button>
  </div>
  <div class="alert alert-error" data-role="error" hidden></div>
  <div class="status-line" data-role="status"></div>

  <h3 class="tool-section-title" style="margin-top:20px"><Icon name="eye" /> {ui.previewLabel}</h3>
  <div class="preview-box" data-role="preview"><span class="preview-placeholder">{ui.previewLabel}</span></div>
  <div class="size-compare">
    <div class="size-item"><div class="k">{ui.originalSize}</div><div class="v" data-role="original-size">—</div></div>
    <div class="size-item highlight"><div class="k">{ui.outputSize}</div><div class="v" data-role="output-size">—</div></div>
    <div class="size-item"><div class="k">{ui.previewLabel}</div><div class="v" data-role="dimension">—</div></div>
  </div>
</div>
