---
import Icon from '../../components/Icon.astro';
const { dict, tool } = Astro.props;
const ui = tool.ui, a = dict.actions;
---
<div class="tool-ui">
  <label class="file-drop" data-role="file-drop">
    <Icon name="upload" size={28} />
    <strong>{ui.selectLabel}</strong>
    <small>{ui.hint}</small>
    <input type="file" data-role="file-input" accept="image/jpeg,image/png,image/webp" />
  </label>
  <div class="status-line" data-role="file-info"></div>

  <div class="field-grid two" style="margin-top:16px">
    <div class="field">
      <label for="rs-width">{ui.width}</label>
      <input class="input" type="number" id="rs-width" data-role="width" min="1" max="20000" placeholder="1920" />
    </div>
    <div class="field">
      <label for="rs-height">{ui.height}</label>
      <input class="input" type="number" id="rs-height" data-role="height" min="1" max="20000" placeholder="1080" />
    </div>
  </div>
  <div class="option-row" style="margin-top:12px">
    <label class="check"><input type="checkbox" data-role="lock" checked /> {ui.lockRatio}</label>
    <div class="field" style="flex:1;min-width:180px">
      <select class="select" data-role="preset" aria-label={ui.presetLabel}>
        <option value="">{ui.presetCustom}</option>
        <option value="1920x1080">1920 × 1080</option>
        <option value="1280x720">1280 × 720</option>
        <option value="1080x1080">1080 × 1080</option>
        <option value="800x600">800 × 600</option>
        <option value="640x640">640 × 640</option>
        <option value="320x320">320 × 320</option>
      </select>
    </div>
  </div>

  <div class="tool-actions">
    <button type="button" class="btn btn-primary" data-role="run"><Icon name="maximize-2" size={16} /> {ui.runLabel}</button>
    <button type="button" class="btn btn-outline" data-role="download" disabled><Icon name="download" size={16} /> {ui.downloadLabel}</button>
    <button type="button" class="btn btn-ghost" data-role="clear"><Icon name="eraser" size={16} /> {a.clear}</button>
  </div>
  <div class="alert alert-error" data-role="error" hidden></div>
  <div class="status-line" data-role="status"></div>

  <h3 class="tool-section-title" style="margin-top:20px"><Icon name="eye" /> {ui.previewLabel}</h3>
  <div class="preview-box" data-role="preview"><span class="preview-placeholder">{ui.previewLabel}</span></div>
  <div class="size-compare">
    <div class="size-item"><div class="k">{ui.originalSize}</div><div class="v" data-role="original-size">—</div></div>
    <div class="size-item"><div class="k">{ui.sizeLabel}</div><div class="v" data-role="dimension">—</div></div>
    <div class="size-item highlight"><div class="k">{ui.outputSize}</div><div class="v" data-role="output-size">—</div></div>
  </div>
</div>
