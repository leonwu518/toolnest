---
import Icon from '../../components/Icon.astro';
import { FORMULAS } from '../../scripts/logic/excel-formula.js';
const { dict, tool } = Astro.props;
const ui = tool.ui, a = dict.actions;
---
<div class="tool-ui">
  <div class="field-grid two">
    <div class="field">
      <label for="fx-type">{ui.formulaLabel}</label>
      <select class="select" id="fx-type" data-role="formula-type">
        {FORMULAS.map((f) => <option value={f.id}>{ui.formulaNames[f.id] || f.id}</option>)}
      </select>
    </div>
    <div class="field">
      <label for="fx-trial">{ui.trialLabel}</label>
      <textarea class="textarea" id="fx-trial" data-role="trial" style="min-height:82px" spellcheck="false">10
20
30</textarea>
    </div>
  </div>
  <p class="field-hint" style="margin-top:6px">{ui.trialHint}</p>

  <h3 class="tool-section-title" style="margin-top:20px"><Icon name="sliders-horizontal" /> {ui.paramsLabel}</h3>
  <div class="field-grid two" data-role="params"></div>

  <h3 class="tool-section-title" style="margin-top:20px"><Icon name="sigma" /> {ui.formulaOutput}</h3>
  <div class="field">
    <div class="output-head">
      <span class="field-label">{ui.formulaOutput}</span>
      <button type="button" class="btn btn-ghost btn-sm" data-role="copy"><Icon name="copy" size={14} /> {a.copy}</button>
    </div>
    <textarea class="textarea" data-role="output" readonly style="min-height:72px;font-size:1rem" spellcheck="false"></textarea>
  </div>

  <div class="stat-grid" style="margin-top:16px">
    <div class="stat-card" style="grid-column:span 2">
      <div class="stat-label"><Icon name="book-open" size={14} /> {ui.descriptionLabel}</div>
      <div class="stat-value" style="font-size:.92rem;line-height:1.6;font-weight:500" data-role="desc">—</div>
    </div>
    <div class="stat-card">
      <div class="stat-label"><Icon name="sigma" size={14} /> {ui.trialResult}</div>
      <div class="stat-value" style="font-size:1.35rem;word-break:break-all" data-role="trial-result">—</div>
    </div>
  </div>

  <div class="tool-actions">
    <button type="button" class="btn btn-primary" data-role="run"><Icon name="wand-sparkles" size={16} /> {ui.runLabel}</button>
    <button type="button" class="btn btn-outline" data-role="download" disabled><Icon name="download" size={16} /> {a.download}</button>
    <button type="button" class="btn btn-ghost" data-role="clear"><Icon name="rotate-ccw" size={16} /> {ui.resetLabel}</button>
  </div>
  <div class="alert alert-error" data-role="error" hidden></div>
  <div class="status-line" data-role="status"></div>
  <p class="field-hint">{ui.hint}</p>
</div>
